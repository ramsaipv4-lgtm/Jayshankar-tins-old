{
  "name": "jayshankar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:storybook": "vite build --config vite.storybook.config.ts && node scripts/rename-storybook-entry.mjs",
    "preview:storybook": "vite preview --config vite.storybook.config.ts",
    "build:storybook-ant": "vite build --config vite.storybook-ant.config.ts && node scripts/rename-storybook-ant-entry.mjs",
    "preview:storybook-ant": "vite preview --config vite.storybook-ant.config.ts",
    "build:storybook-run": "vite build --config vite.storybook-run.config.ts && node scripts/rename-storybook-run-entry.mjs",
    "preview:storybook-run": "vite preview --config vite.storybook-run.config.ts",
    "dev:storybook-run": "vite --config vite.storybook-run.config.ts --open /storybook-run.html",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "validate": "tsc --noEmit && node scripts/validate.mjs",
    "selftest": "node --test scripts/selftest.mjs",
    "perf": "node scripts/perf-check.mjs",
    "cap:sync": "vite build && npx cap sync android"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.51.0",
    "antd": "^6.6.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "hyperframes": "^0.8.36",
    "playwright": "^1.63.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.0.0",
    "xlsx": "^0.18.5"
  }
}
