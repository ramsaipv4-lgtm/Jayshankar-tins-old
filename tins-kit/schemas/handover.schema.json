{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tins-kit/schemas/handover.schema.json",
  "title": "HANDOVER.md structure",
  "description": "The structure of a TINS consumer's HANDOVER.md. Validated by the kit's validate.mjs §8.1.",
  "type": "object",
  "required": ["header", "state_snapshot", "work_queue"],
  "additionalProperties": false,
  "properties": {
    "header": {
      "type": "object",
      "required": ["last_updated", "last_worked_on_by", "current_queue_position"],
      "additionalProperties": false,
      "properties": {
        "last_updated": {
          "description": "ISO 8601 date of the last update.",
          "type": "string",
          "format": "date"
        },
        "last_worked_on_by": {
          "description": "Name of the last contributor (human or LLM session).",
          "type": "string",
          "minLength": 1
        },
        "current_queue_position": {
          "description": "The next W<n> to work on. Must be one more than the last completed W<n>.",
          "type": "string",
          "pattern": "^W[0-9]+$"
        }
      }
    },
    "state_snapshot": {
      "type": "object",
      "description": "The 'what is true today' list. Each field is optional but if present must be a string.",
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "dev_server": { "type": "string" },
        "db": { "type": "string" },
        "tests": { "type": "string" },
        "build": { "type": "string" },
        "deploy": { "type": "string" },
        "users": { "type": "string" }
      }
    },
    "work_queue": {
      "description": "The W-queue, in order. Each W-item is either pending (⏳), in progress, done (✅), partial (🔶), or blocked (🚫).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^W[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "goal": { "type": "string" },
          "read": {
            "description": "List of files to read first.",
            "type": "array",
            "items": { "type": "string" }
          },
          "change": { "type": "string" },
          "verify": { "type": "string" },
          "done_when": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["done", "partial", "in_progress", "blocked", "pending"]
          },
          "status_date": {
            "type": "string",
            "format": "date",
            "description": "If status is done/partial/blocked, the date the status was set."
          },
          "notes": { "type": "string" }
        }
      }
    },
    "gotchas": {
      "description": "List of gotchas (each: symptom + fix + reproduce).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "symptom", "fix", "reproduce"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "symptom": { "type": "string" },
          "fix": { "type": "string" },
          "reproduce": { "type": "string" }
        }
      }
    }
  }
}
